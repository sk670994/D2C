{
  "crons": [
    {
      "path": "/api/cron/fetch-ad-data",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/refresh-tracked-adspy",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/adspy/drain",
      "schedule": "45 20 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/decode-ads",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/ops-health",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/rival-alerts",
      "schedule": "30 2 * * *"
    }
  ],
  "functions": {
    "app/api/queues/adspy-collection/route.ts": {
      "maxDuration": 60,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "adspy-collection"
        }
      ]
    }
  }
}
