# Copy to worker/.env on the VPS. Never commit worker/.env.
NEXT_PUBLIC_SUPABASE_URL=https://ckbugtonybyyudfjtvjj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Required: use Playwright's own Chromium (installed in the image).
ADSPY_BROWSER=playwright

# Required: this process is the collector (waiting runs are not failed after 3 min).
ADSPY_COLLECTOR=worker

# Per-job time budget (ms). A job stops scrolling and saves what it has.
ADSPY_WORKER_BUDGET_MS=480000
ADSPY_DEEP_MAX_SCROLLS=360

# Resource guards
ADSPY_WORKER_RECYCLE_JOBS=15
ADSPY_WORKER_MAX_RSS_MB=1200
ADSPY_WORKER_MIN_TMP_MB=512

# Store ad images permanently (Supabase Storage bucket "ad-media").
ADSPY_STORE_MEDIA=1

# Optional: AI labelling of ads while the worker is idle (Google AI Studio key).
GEMINI_API_KEY=
# GEMINI_DECODE_MODEL=gemini-2.5-flash

# Optional: route the worker's browser through a proxy (recommended on a cloud
# server; Meta blocks datacenter IPs faster). Residential / ISP proxy in India.
# ADSPY_PROXY_URL=http://user:pass@proxy-host:8000

# SearchApi.io key: only needed here to run scripts/ops/searchapi-benchmark.ts.
# In production it lives in Vercel (collection then runs there, not on this PC).
# SEARCHAPI_API_KEY=
