# ---------------------------------------------------------------
# Zooptrack environment variables (names only — never commit values)
# Set these in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security (generate each with: openssl rand -hex 32)
OAUTH_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Admin (email allowed to open admin views)
NEXT_PUBLIC_ADMIN_EMAIL=

# Gemini (ZWIRK + insights)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=25000

# Meta (Ads OAuth + Ad Library API)
META_APP_ID=
META_APP_SECRET=
META_ADS_REDIRECT_URI=
META_GRAPH_VERSION=
META_AD_LIBRARY_ACCESS_TOKEN=

# Google Ads (OAuth + reporting)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=

# AdSpy scraper (Chromium for Playwright)
CHROMIUM_PACK_URL=
# Local development only
IS_LOCAL=
CHROME_EXECUTABLE_PATH=
EDGE_EXECUTABLE_PATH=

# Optional / not currently wired
SEARCHAPI_API_KEY=
ADSPY_AUTOCOMPLETE_LIVE_ENRICHMENT=
